<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Inventrack.InventoryPage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto"
          Padding="20, 20, 20, 12"
          RowSpacing="16">

        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label Text="Inventory"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#1B2430" />
            <Label Text="Total Units in Stock"
                   FontSize="14"
                   TextColor="#5C6B73" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
                StrokeShape="RoundRectangle 24"
                StrokeThickness="1"
                Stroke="#1B2430"
                Padding="14, 4"
                HeightRequest="48">
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                <Image Grid.Column="0"
                       Source="search.png"
                       WidthRequest="18"
                       HeightRequest="18"
                       VerticalOptions="Center" />
                <Entry Grid.Column="1"
                       Placeholder="Search Product"
                       PlaceholderColor="#5C6B73"
                       TextColor="#1B2430"
                       FontSize="15"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <Label Grid.Row="2"
               Text="All Products"
               FontSize="15"
               FontAttributes="Bold"
               TextColor="#1B2430" />

        <ScrollView Grid.Row="3">
            <VerticalStackLayout Spacing="12">

                <!-- Product 1: Biogesic -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Stroke="#8A929A"
                        Padding="12">
                    <Grid ColumnDefinitions="110, *" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                HeightRequest="110"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Stroke="#8A929A">
                            <Image Source="dotnet_bot.png"
                                   WidthRequest="44"
                                   HeightRequest="44"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Critical Stock"
                                   FontSize="11"
                                   TextColor="Red"
                                   FontAttributes="Bold" />
                            <Label Text="Biogesic 500mg Paracetamol"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1B2430" />
                            <Label Text="Current: 14 tabs | Reorder Level: 100 tabs"
                                   FontSize="11"
                                   TextColor="#5C6B73" />

                            <Grid ColumnDefinitions="*, Auto" Margin="0, 4, 0, 0" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="₱4.50"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1B2430"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Add Product"
                                        FontSize="11"
                                        HeightRequest="32"
                                        Padding="12, 0"
                                        CornerRadius="6"
                                        BorderWidth="1"
                                        BorderColor="#8A929A"
                                        BackgroundColor="Transparent"
                                        TextColor="#1B2430" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Product 2: Neozep -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Stroke="#8A929A"
                        Padding="12">
                    <Grid ColumnDefinitions="110, *" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                HeightRequest="110"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Stroke="#8A929A">
                            <Image Source="dotnet_bot.png"
                                   WidthRequest="44"
                                   HeightRequest="44"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Low Stock"
                                   FontSize="11"
                                   TextColor="Red"
                                   FontAttributes="Bold" />
                            <Label Text="Neozep Forte Cold &amp; Flu"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1B2430" />
                            <Label Text="Current: 28 tabs | Reorder Level: 80 tabs"
                                   FontSize="11"
                                   TextColor="#5C6B73" />

                            <Grid ColumnDefinitions="*, Auto" Margin="0, 4, 0, 0" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="₱6.25"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1B2430"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Add Product"
                                        FontSize="11"
                                        HeightRequest="32"
                                        Padding="12, 0"
                                        CornerRadius="6"
                                        BorderWidth="1"
                                        BorderColor="#8A929A"
                                        BackgroundColor="Transparent"
                                        TextColor="#1B2430" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Product 3: Solmux -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Stroke="#8A929A"
                        Padding="12">
                    <Grid ColumnDefinitions="110, *" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                HeightRequest="110"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Stroke="#8A929A">
                            <Image Source="dotnet_bot.png"
                                   WidthRequest="44"
                                   HeightRequest="44"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Low Stock"
                                   FontSize="11"
                                   TextColor="Red"
                                   FontAttributes="Bold" />
                            <Label Text="Solmux 500mg Carbocisteine"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1B2430" />
                            <Label Text="Current: 18 caps | Reorder Level: 60 caps"
                                   FontSize="11"
                                   TextColor="#5C6B73" />

                            <Grid ColumnDefinitions="*, Auto" Margin="0, 4, 0, 0" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="₱11.50"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1B2430"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Add Product"
                                        FontSize="11"
                                        HeightRequest="32"
                                        Padding="12, 0"
                                        CornerRadius="6"
                                        BorderWidth="1"
                                        BorderColor="#8A929A"
                                        BackgroundColor="Transparent"
                                        TextColor="#1B2430" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Product 4: Alaxan FR -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Stroke="#8A929A"
                        Padding="12">
                    <Grid ColumnDefinitions="110, *" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                HeightRequest="110"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Stroke="#8A929A">
                            <Image Source="dotnet_bot.png"
                                   WidthRequest="44"
                                   HeightRequest="44"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="In Stock"
                                   FontSize="11"
                                   TextColor="#5C6B73"
                                   FontAttributes="Bold" />
                            <Label Text="Alaxan FR Ibuprofen + Paracetamol"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1B2430" />
                            <Label Text="Current: 120 caps | Reorder Level: 50 caps"
                                   FontSize="11"
                                   TextColor="#5C6B73" />

                            <Grid ColumnDefinitions="*, Auto" Margin="0, 4, 0, 0" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="₱8.75"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1B2430"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Add Product"
                                        FontSize="11"
                                        HeightRequest="32"
                                        Padding="12, 0"
                                        CornerRadius="6"
                                        BorderWidth="1"
                                        BorderColor="#8A929A"
                                        BackgroundColor="Transparent"
                                        TextColor="#1B2430" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Product 5: Bioflu -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Stroke="#8A929A"
                        Padding="12">
                    <Grid ColumnDefinitions="110, *" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                HeightRequest="110"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Stroke="#8A929A">
                            <Image Source="dotnet_bot.png"
                                   WidthRequest="44"
                                   HeightRequest="44"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="In Stock"
                                   FontSize="11"
                                   TextColor="#5C6B73"
                                   FontAttributes="Bold" />
                            <Label Text="Bioflu 10mg / 2mg / 500mg"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1B2430" />
                            <Label Text="Current: 94 tabs | Reorder Level: 50 tabs"
                                   FontSize="11"
                                   TextColor="#5C6B73" />

                            <Grid ColumnDefinitions="*, Auto" Margin="0, 4, 0, 0" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="₱7.00"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1B2430"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Add Product"
                                        FontSize="11"
                                        HeightRequest="32"
                                        Padding="12, 0"
                                        CornerRadius="6"
                                        BorderWidth="1"
                                        BorderColor="#8A929A"
                                        BackgroundColor="Transparent"
                                        TextColor="#1B2430" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="4"
                StrokeThickness="0"
                Padding="0, 8, 0, 0">
            <Grid ColumnDefinitions="*, *, *, *">
                <!-- Home Tab (Clickable) -->
                <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped" />
                        
                    </VerticalStackLayout.GestureRecognizers>

                    <Image Source="house.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                            
                    <Label Text="Home" FontSize="11" TextColor="#5C6B73" HorizontalOptions="Center" />
                </VerticalStackLayout>
                
                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                    <Image Source="archive.png"
                           WidthRequest="22"
                           HeightRequest="22"
                           HorizontalOptions="Center" />
                    <Label Text="Inventory"
                           FontSize="11"
                           TextColor="#1B2430"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                    <Image Source="bar_chart.png"
                           WidthRequest="22"
                           HeightRequest="22"
                           HorizontalOptions="Center" />
                    <Label Text="Analytics"
                           FontSize="11"
                           TextColor="#5C6B73"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center">
                    <Image Source="gear.png"
                           WidthRequest="22"
                           HeightRequest="22"
                           HorizontalOptions="Center" />
                    <Label Text="Settings"
                           FontSize="11"
                           TextColor="#5C6B73"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>