<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Inventrack.MainPage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*, Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="20" Padding="20, 16, 20, 16">

                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                    <Border Grid.Column="0"
                            WidthRequest="48"
                            HeightRequest="48"
                            StrokeShape="RoundRectangle 24"
                            StrokeThickness="0">
                        <Image Source="user.png"
                               WidthRequest="22"
                               HeightRequest="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <BoxView Grid.Column="1"
                             HorizontalOptions="Start"
                             Margin="12, 0, 0, 0"
                             WidthRequest="110"
                             HeightRequest="16"
                             Color="#415265"
                             VerticalOptions="Center" />

                    <Border Grid.Column="2"
                            WidthRequest="48"
                            HeightRequest="48"
                            StrokeShape="RoundRectangle 24"
                            StrokeThickness="0">
                        <Image Source="bell.png"
                               WidthRequest="22"
                               HeightRequest="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Hi, Kier"
                           FontSize="15"
                           TextColor="#415265" />
                    <Label Text="Good Morning!"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#1B2430" />
                </VerticalStackLayout>

                <Border StrokeShape="RoundRectangle 24"
                        StrokeThickness="1"
                        Stroke="#1B2430"
                        Padding="14, 4"
                        HeightRequest="48">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                        <Image Grid.Column="0"
                               Source="search.png"
                               WidthRequest="18"
                               HeightRequest="18"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               Placeholder="Search Product"
                               PlaceholderColor="#5C6B73"
                               TextColor="#1B2430"
                               FontSize="15"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Label Text="Low Stock Alerts"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#1B2430" />

                <!-- Images start -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Stroke="#8A929A"
                        Padding="12">
                    <Grid ColumnDefinitions="110, *" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                HeightRequest="110"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Stroke="#8A929A">
                            <Image Source="biogesic.webp"
                                   WidthRequest="100"
                                   HeightRequest="100"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Critical Stock"
                                   FontSize="11"
                                   TextColor="Red"
                                   FontAttributes="Bold" />
                            <Label Text="Biogesic 500mg Paracetamol"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1B2430" />
                            <Label Text="Current: 14 tabs | Reorder Level: 100 tabs"
                                   FontSize="11"
                                   TextColor="#5C6B73" />

                            <Grid ColumnDefinitions="*, Auto" Margin="0, 4, 0, 0" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="₱4.50"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1B2430"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Reorder"
                                        FontSize="11"
                                        HeightRequest="32"
                                        Padding="12, 0"
                                        CornerRadius="6"
                                        BorderWidth="1"
                                        BorderColor="Black"
                                        Background="White"
                                        TextColor="#1B2430" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Stroke="#8A929A"
                        Padding="12">
                    <Grid ColumnDefinitions="110, *" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                HeightRequest="110"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Stroke="#8A929A">
                            <Image Source="neozep.webp"
                                   WidthRequest="90"
                                   HeightRequest="90"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Low Stock"
                                   FontSize="11"
                                   TextColor="Red"
                                   FontAttributes="Bold" />
                            <Label Text="Neozep Forte Cold &amp; Flu"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1B2430" />
                            <Label Text="Current: 28 tabs | Reorder Level: 80 tabs"
                                   FontSize="11"
                                   TextColor="#5C6B73" />

                            <Grid ColumnDefinitions="*, Auto" Margin="0, 4, 0, 0" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="₱6.25"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1B2430"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Reorder"
                                        FontSize="11"
                                        HeightRequest="32"
                                        Padding="12, 0"
                                        CornerRadius="6"
                                        BorderWidth="1"
                                        BorderColor="Black"
                                        Background="White"
                                        TextColor="#1B2430" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Stroke="#8A929A"
                        Padding="12">
                    <Grid ColumnDefinitions="110, *" ColumnSpacing="14">
                        <Border Grid.Column="0"
                                HeightRequest="110"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1"
                                Stroke="#8A929A">
                            <Image Source="solmux.jpg"
                                   WidthRequest="100"
                                   HeightRequest="100"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Low Stock"
                                   FontSize="11"
                                   TextColor="Red"
                                   FontAttributes="Bold" />
                            <Label Text="Solmux 500mg Carbocisteine"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1B2430" />
                            <Label Text="Current: 18 caps | Reorder Level: 60 caps"
                                   FontSize="11"
                                   TextColor="#5C6B73" />

                            <Grid ColumnDefinitions="*, Auto" Margin="0, 4, 0, 0" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="₱11.50"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1B2430"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Reorder"
                                        FontSize="11"
                                        HeightRequest="32"
                                        Padding="12, 0"
                                        CornerRadius="6"
                                        BorderWidth="1"
                                        BorderColor="Black"
                                        Background="White"
                                        TextColor="#1B2430" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label Text="Quick Actions"
                       FontSize="15"
                       FontAttributes="Bold"
                       TextColor="#415265" />

                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                    <Border Grid.Column="0"
                            HeightRequest="52"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1"
                            Stroke="#1B2430">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="barcode.png"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   HorizontalOptions="Center" />
                            <Label Text="Scan Barcode"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#1B2430"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            HeightRequest="52"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1"
                            Stroke="#1B2430">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="arrows_sync.png"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   HorizontalOptions="Center" />
                            <Label Text="Stock In/Out"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#1B2430"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2"
                            HeightRequest="52"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1"
                            Stroke="#1B2430">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="plus.png"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   HorizontalOptions="Center" />
                            <Label Text="New Item"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#1B2430"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="6"
        StrokeThickness="0"
        Padding="0, 8, 0, 0">
            <Grid ColumnDefinitions="*, *, *, *">

                <!-- Home Tab -->
                <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                    <Image Source="house.png"
                   WidthRequest="22"
                   HeightRequest="22"
                   HorizontalOptions="Center" />
                    <Label Text="Home"
                   FontSize="11"
                   TextColor="#1B2430"
                   HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Inventory Tab (Clickable) -->
                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnInventoryTapped" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Image Source="archive.png"
                   WidthRequest="22"
                   HeightRequest="22"
                   HorizontalOptions="Center" />
                    <Label Text="Inventory"
                   FontSize="11"
                   TextColor="#5C6B73"
                   HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Analytics Tab -->
                <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                    <Image Source="bar_chart.png"
                   WidthRequest="22"
                   HeightRequest="22"
                   HorizontalOptions="Center" />
                    <Label Text="Analytics"
                   FontSize="11"
                   TextColor="#5C6B73"
                   HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Settings Tab -->
                <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center">
                    <Image Source="gear.png"
                   WidthRequest="22"
                   HeightRequest="22"
                   HorizontalOptions="Center" />
                    <Label Text="Settings"
                   FontSize="11"
                   TextColor="#5C6B73"
                   HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>